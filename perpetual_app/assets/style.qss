* { font-family: 'Segoe UI'; font-size: 13px; color: #213044; }
QMainWindow, QWidget#canvas { background: #f4f6f8; }
QFrame#sidebar { background: #001426; border: none; }
QFrame#sidebar QLabel { color: #8fa5bc; }
QFrame#sidebar QLabel#credit { color: #6c8296; font-size: 11px; }
QPushButton#nav { text-align: center; padding: 13px 15px; border: 0; border-radius: 7px; color: #b1c2d3; background: transparent; font-size: 13px; }
QPushButton#nav:hover { background: #203249; color: white; }
QPushButton#nav:checked { background: #2a4057; color: white; border-left: 3px solid #50c8bc; border-right: 3px solid transparent; }
QFrame#connectionBar { background: white; border-bottom: 1px solid #dde4eb; }
QLabel#armingState { font-size: 28px; font-weight: 700; letter-spacing: 1px; color: #8190a2; }
QLabel#armingState[state="disarmed"] { color: #187f73; }
QLabel#armingState[state="armed"] { color: #c43d3d; }
QLabel#armingState[state="arming"], QLabel#armingState[state="closing"] { color: #b17a25; }
QFrame#card { background: white; border: 1px solid #dfe5eb; border-radius: 10px; }
QFrame#notice { background: #fff6e6; border: 1px solid #f0d5a2; border-radius: 8px; }
QFrame#draftBar { background: #fff6e6; border: 1px solid #efcf95; border-radius: 8px; }
QLabel#eyebrow { color: #758699; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
QLabel#title { color: #17283a; font-size: 28px; font-weight: 700; }
QLabel#subtitle { color: #728093; font-size: 13px; }
QLabel#cardTitle { color: #27384b; font-size: 15px; font-weight: 600; }
QLabel#metric { color: #183147; font-size: 27px; font-weight: 600; }
QLabel#hint { color: #7b8998; font-size: 12px; }
QLabel#sensorStatus { color: #7b8998; }
QLabel#sensorStatus[state="available"] { color: #187f73; }
QLabel#sensorStatus[state="unavailable"] { color: #c43d3d; }
QLabel#pill { padding: 5px 10px; border-radius: 5px; font-size: 11px; font-weight: 600; background: #eef2f6; color: #5c6d80; }
QLabel#powerSaveBadge { padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 700; background: #e6f3f0; color: #187f73; }
QPushButton { background: white; border: 1px solid #d3dce5; padding: 8px 14px; border-radius: 6px; font-weight: 600; }
QPushButton:hover { background: #edf4f6; border-color: #9db9c1; }
QPushButton:pressed { background: #dbe9ed; }
QPushButton:disabled { color: #a3aeb9; background: #f4f6f8; border-color: #e1e6eb; }
QPushButton#primary { color: white; background: #167c76; border-color: #167c76; }
QPushButton#primary:hover { background: #12665f; }
QPushButton#primary:disabled { color: #a1b8b6; background: #e1edeb; border-color: #d4e3e1; }
QPushButton#primary[blocked="true"]:disabled { color: white; background: #c43d3d; border-color: #c43d3d; }
QPushButton#danger { color: #ae4a45; border-color: #dfbfbc; }
QPushButton#danger:disabled { color: #bfb0af; border-color: #e5dedd; }
QPushButton#downloadCancel, QPushButton#configureServo { color: white; background: #c43d3d; border-color: #c43d3d; }
QPushButton#downloadCancel:hover, QPushButton#configureServo:hover { background: #ac3030; border-color: #ac3030; }
QPushButton#downloadCancel:disabled, QPushButton#configureServo:disabled { color: #fff; background: #d99b9b; border-color: #d99b9b; }
QSlider::groove:horizontal { height: 5px; background: #e2e9ed; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #24968b; border-radius: 2px; }
QSlider::handle:horizontal { width: 16px; margin: -6px 0; background: #167c76; border: 2px solid white; border-radius: 9px; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: white; border: 1px solid #ccd7e2; padding: 7px; border-radius: 5px; selection-background-color: #167c76; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #218e84; }
QSpinBox, QDoubleSpinBox { padding-right: 30px; min-height: 20px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; height: 16px; margin: 2px 2px 0 0; border: none; border-top-right-radius: 4px; background: #f0f5f5; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; height: 16px; margin: 0 2px 2px 0; border: none; border-bottom-right-radius: 4px; background: #f0f5f5; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background: #dfedeb; }
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed, QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed { background: #c8e1dd; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(perpetual:chevron-up.svg); width: 10px; height: 7px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(perpetual:chevron-down.svg); width: 10px; height: 7px; }
QSpinBox[milliseconds="true"] { padding-right: 7px; }
QSpinBox[milliseconds="true"]::up-button, QSpinBox[milliseconds="true"]::down-button { width: 0; height: 0; margin: 0; }
QSpinBox[milliseconds="true"]::up-arrow, QSpinBox[milliseconds="true"]::down-arrow { image: none; width: 0; height: 0; }
QLabel#servoPwm { color: #183147; }
QLabel#servoPwm:disabled { color: #a3aeb9; }
QPushButton#servoLive:checked { color: white; background: #187f73; border-color: #187f73; }
QPushButton#servoLive:checked:hover { background: #12665e; }
QSlider::sub-page:horizontal:disabled, QSlider::handle:horizontal:disabled { background: #bcc8ce; }
QComboBox { padding-right: 30px; }
QComboBox::drop-down { subcontrol-origin: border; subcontrol-position: top right; border: none; width: 28px; }
QComboBox::down-arrow { image: url(perpetual:chevron-down.svg); width: 12px; height: 8px; }
QCheckBox { spacing: 8px; }
QTabWidget::pane { border: none; background: transparent; }
QTabBar::tab { background: transparent; padding: 10px 20px; color: #758699; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #147b74; border-bottom-color: #147b74; }
QTableWidget, QTreeWidget { background: white; border: none; gridline-color: #eef1f5; outline: none; selection-background-color: #e5f1ef; selection-color: #123f3a; }
QHeaderView::section { background: #f8fafb; color: #718095; padding: 11px 9px; border: none; border-bottom: 1px solid #e7ecf0; font-size: 11px; font-weight: 600; }
QTableWidget::item, QTreeWidget::item { padding: 8px; border-bottom: 1px solid #f0f3f5; }
QTreeWidget#rulesTree { selection-background-color: #167c76; selection-color: white; }
QTreeWidget#rulesTree::item:selected { background: #167c76; color: white; border-bottom-color: #167c76; }
QTreeWidget#rulesTree::branch:selected { background: #167c76; }
QPlainTextEdit { background: #142235; color: #b5cddf; border: none; border-radius: 8px; padding: 12px; font-family: 'Cascadia Code', Consolas; font-size: 12px; }
QProgressBar { border: none; background: #e5ecef; height: 8px; border-radius: 4px; color: transparent; }
QProgressBar::chunk { background: #24968b; border-radius: 4px; }
QProgressBar#downloadProgress { color: #213044; min-height: 18px; text-align: center; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 1px; border: none; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 1px; border: none; }
QScrollBar::handle { background: #a7b5c2; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 32px; }
QScrollBar::handle:horizontal { min-width: 32px; }
QScrollBar::handle:hover { background: #748a9c; }
QScrollBar::handle:pressed { background: #167c76; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: transparent; }
QScrollBar::up-arrow, QScrollBar::down-arrow, QScrollBar::left-arrow, QScrollBar::right-arrow { image: none; width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QAbstractScrollArea::corner { background: transparent; }
QDialog { background: #f4f6f8; }
QDialogButtonBox { padding-top: 10px; }
QToolTip { color: #23374a; background: #fff; border: 1px solid #d7e0e8; padding: 7px; }
