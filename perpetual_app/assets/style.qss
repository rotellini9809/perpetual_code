* { font-family: 'Segoe UI'; font-size: 13px; color: #213044; }
QMainWindow, QWidget#canvas { background: #f4f6f8; }
QFrame#sidebar { background: #001426; border: none; }
QFrame#sidebar QLabel { color: #8fa5bc; }
QFrame#sidebar QLabel#credit { color: #6c8296; font-size: 11px; }
QPushButton#nav { text-align: center; padding: 13px 15px; border: 0; border-radius: 7px; color: #b1c2d3; background: transparent; font-size: 13px; }
QPushButton#nav:hover { background: #203249; color: white; }
QPushButton#nav:checked { background: #2a4057; color: white; border-left: 3px solid #50c8bc; border-right: 3px solid transparent; }
QFrame#connectionBar { background: white; border-bottom: 1px solid #dde4eb; }
QLabel#armingState { font-size: 28px; font-weight: 700; letter-spacing: 1px; color: #8190a2; }
QLabel#armingState[state="disarmed"] { color: #187f73; }
QLabel#armingState[state="armed"] { color: #c43d3d; }
QLabel#armingState[state="arming"], QLabel#armingState[state="closing"] { color: #b17a25; }
QFrame#card { background: white; border: 1px solid #dfe5eb; border-radius: 10px; }
QFrame#sectionDivider { background: #e1e7ed; border: none; }
QFrame#notice { background: #fff6e6; border: 1px solid #f0d5a2; border-radius: 8px; }
QFrame#draftBar { background: #fff6e6; border: 1px solid #efcf95; border-radius: 8px; }
QLabel#eyebrow { color: #758699; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
QLabel#title { color: #17283a; font-size: 28px; font-weight: 700; }
QLabel#subtitle { color: #728093; font-size: 13px; }
QLabel#cardTitle { color: #27384b; font-size: 15px; font-weight: 600; }
QLabel#metric { color: #183147; font-size: 27px; font-weight: 600; }
QLabel#hint, QLabel#emptyState { color: #7b8998; font-size: 12px; }
QLabel#emptyState { font-size: 14px; }
QLabel#simPreflightError { color: #c43d3d; }
QLabel#sensorStatus { color: #7b8998; }
QLabel#sensorStatus[state="available"] { color: #187f73; }
QLabel#sensorStatus[state="unavailable"] { color: #c43d3d; }
QLabel#pill { padding: 5px 10px; border-radius: 5px; font-size: 11px; font-weight: 600; background: #eef2f6; color: #5c6d80; }
QLabel#powerSaveBadge { padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 700; background: #e6f3f0; color: #187f73; }
QLabel#featureBadge { padding: 7px 13px; border: 1px solid #e0e6ed; border-radius: 7px; font-size: 13px; font-weight: 600; background: #f1f4f7; color: #8c99a7; }
QLabel#featureBadge[active="true"] { background: #f4e5bd; color: #806019; border-color: #d9bd75; }
QPushButton { background: white; border: 1px solid #d3dce5; padding: 8px 14px; border-radius: 6px; font-weight: 600; }
QPushButton:hover { background: #edf4f6; border-color: #9db9c1; }
QPushButton:pressed { background: #dbe9ed; }
QPushButton:disabled { color: #a3aeb9; background: #f4f6f8; border-color: #e1e6eb; }
QPushButton#primary, QPushButton#saveAction { color: white; background: #167c76; border-color: #167c76; }
QPushButton#primary:hover, QPushButton#saveAction:hover { background: #12665f; }
QPushButton#saveAction:pressed { background: #10584f; border-color: #10584f; }
QPushButton#saveAction:disabled { color: #a3aeb9; background: #f4f6f8; border-color: #e1e6eb; }
QPushButton#primary:disabled { color: #a1b8b6; background: #e1edeb; border-color: #d4e3e1; }
QPushButton#primary[servoPreparation="true"]:disabled { color: #f4fbf9; background: #8ebeb5; border-color: #8ebeb5; }
QPushButton#armFlight { font-size: 17px; font-weight: 700; letter-spacing: 1px; padding: 10px 24px; border-radius: 8px; }
QPushButton#armFlight, QPushButton#releaseServo { color: white; background: #c43d3d; border-color: #c43d3d; }
QPushButton#armFlight:hover, QPushButton#releaseServo:hover { background: #ad3030; border-color: #ad3030; }
QPushButton#armFlight:pressed, QPushButton#releaseServo:pressed { background: #942828; border-color: #942828; }
QPushButton#armFlight:disabled, QPushButton#releaseServo:disabled { color: #fff5f5; background: #dda3a3; border-color: #dda3a3; }
QPushButton#armFlight[disarming="false"] { color: white; background: #218653; border-color: #218653; }
QPushButton#armFlight[disarming="false"]:hover { background: #197044; border-color: #197044; }
QPushButton#armFlight[disarming="false"]:pressed { background: #125c37; border-color: #125c37; }
QPushButton#armFlight[disarming="false"]:disabled { color: #f2fff7; background: #a0c6b0; border-color: #a0c6b0; }
QPushButton#danger { color: #ae4a45; border-color: #dfbfbc; }
QPushButton#danger:disabled { color: #bfb0af; border-color: #e5dedd; }
QPushButton#inlineLink { color: #167c76; background: transparent; border: 0; padding: 0; text-decoration: underline; }
QPushButton#inlineLink:hover { color: #10584f; }
QPushButton#inlineLink:disabled { color: #a3aeb9; }
QPushButton#downloadCancel, QPushButton#configureServo { color: white; background: #c43d3d; border-color: #c43d3d; }
QPushButton#downloadCancel:hover, QPushButton#configureServo:hover { background: #ac3030; border-color: #ac3030; }
QPushButton#downloadCancel:disabled, QPushButton#configureServo:disabled { color: #fff; background: #d99b9b; border-color: #d99b9b; }
QSlider::groove:horizontal { height: 5px; background: #e2e9ed; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #24968b; border-radius: 2px; }
QSlider::handle:horizontal { width: 16px; margin: -6px 0; background: #167c76; border: 2px solid white; border-radius: 9px; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: white; border: 1px solid #ccd7e2; padding: 7px; border-radius: 5px; selection-background-color: #167c76; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #218e84; }
QSpinBox, QDoubleSpinBox { padding-right: 30px; min-height: 20px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; height: 16px; margin: 2px 2px 0 0; border: none; border-top-right-radius: 4px; background: #f0f5f5; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; height: 16px; margin: 0 2px 2px 0; border: none; border-bottom-right-radius: 4px; background: #f0f5f5; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background: #dfedeb; }
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed, QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed { background: #c8e1dd; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(perpetual:chevron-up.svg); width: 10px; height: 7px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(perpetual:chevron-down.svg); width: 10px; height: 7px; }
QSpinBox[milliseconds="true"] { padding-right: 7px; }
QSpinBox[milliseconds="true"]::up-button, QSpinBox[milliseconds="true"]::down-button { width: 0; height: 0; margin: 0; }
QSpinBox[milliseconds="true"]::up-arrow, QSpinBox[milliseconds="true"]::down-arrow { image: none; width: 0; height: 0; }
QLabel#servoPwm { color: #183147; }
QLabel#servoPwm:disabled { color: #a3aeb9; }
QPushButton#servoLive:checked { color: white; background: #187f73; border-color: #187f73; }
QPushButton#servoLive:checked:hover { background: #12665e; }
QSlider::sub-page:horizontal:disabled, QSlider::handle:horizontal:disabled { background: #bcc8ce; }
QComboBox { padding-right: 30px; }
QComboBox::drop-down { subcontrol-origin: border; subcontrol-position: top right; border: none; width: 28px; }
QComboBox::down-arrow { image: url(perpetual:chevron-down.svg); width: 12px; height: 8px; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #b7c6d4; border-radius: 4px; background: white; }
QCheckBox::indicator:hover { border-color: #167c76; background: #edf6f4; }
QCheckBox::indicator:checked { border-color: #167c76; background: #167c76; image: url(perpetual:check-white.svg); }
QCheckBox::indicator:indeterminate { border-color: #167c76; background: #167c76; image: url(perpetual:check-partial.svg); }
QCheckBox::indicator:disabled { border-color: #d7dfe6; background: #f0f3f6; }
QCheckBox::indicator:checked:disabled, QCheckBox::indicator:indeterminate:disabled { border-color: #a5c7c1; background: #a5c7c1; }
QComboBox QAbstractItemView { color: #213044; background: white; alternate-background-color: #f4f6f8; border: 1px solid #ccd7e2; selection-background-color: #e5f1ef; selection-color: #123f3a; outline: none; }
QComboBox QAbstractItemView::item { min-height: 28px; padding: 4px 8px; }
QComboBox QAbstractItemView::item:selected { color: #123f3a; background: #e5f1ef; }
QMenu { color: #213044; background: white; border: 1px solid #ccd7e2; }
QMenu::item:selected { color: #123f3a; background: #e5f1ef; }
QLabel#actuatorStatus[preparation="prepared"] { color: #187f73; }
QLabel#actuatorStatus[preparation="unprepared"] { color: #c43d3d; }
QTabWidget::pane { border: none; background: transparent; }
QTabBar::tab { background: transparent; padding: 10px 20px; color: #758699; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #147b74; border-bottom-color: #147b74; }
QTableWidget, QTreeWidget { background: white; border: none; gridline-color: #eef1f5; outline: none; selection-background-color: #e5f1ef; selection-color: #123f3a; }
QHeaderView::section { background: #f8fafb; color: #718095; padding: 11px 9px; border: none; border-bottom: 1px solid #e7ecf0; font-size: 11px; font-weight: 600; }
QTableWidget::item, QTreeWidget::item { padding: 8px; border-bottom: 1px solid #f0f3f5; }
QTreeWidget#rulesTree { selection-background-color: #edf6f3; selection-color: #213044; }
QTreeWidget#rulesTree::item:selected { background: #edf6f3; color: #213044; border-bottom-color: #dbe8e3; }
QTreeWidget#rulesTree::branch:selected { background: #edf6f3; }
QTreeWidget#rulesTree::branch:has-children:closed { image: url(perpetual:chevron-right.svg); }
QTreeWidget#rulesTree::branch:has-children:open { image: url(perpetual:chevron-down.svg); }
QPlainTextEdit { background: #142235; color: #b5cddf; border: none; border-radius: 8px; padding: 12px; font-family: 'Cascadia Code', Consolas; font-size: 12px; }
QProgressBar { border: none; background: #e5ecef; height: 8px; border-radius: 4px; color: transparent; }
QProgressBar::chunk { background: #24968b; border-radius: 4px; }
QProgressBar#downloadProgress { color: #213044; min-height: 18px; text-align: center; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 1px; border: none; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 1px; border: none; }
QScrollBar::handle { background: #a7b5c2; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 32px; }
QScrollBar::handle:horizontal { min-width: 32px; }
QScrollBar::handle:hover { background: #748a9c; }
QScrollBar::handle:pressed { background: #167c76; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: transparent; }
QScrollBar::up-arrow, QScrollBar::down-arrow, QScrollBar::left-arrow, QScrollBar::right-arrow { image: none; width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QAbstractScrollArea::corner { background: transparent; }
QDialog { background: #f4f6f8; }
QDialogButtonBox { padding-top: 10px; }
QToolTip { color: #23374a; background: #fff; border: 1px solid #d7e0e8; padding: 7px; }

QCheckBox#actuatorName, QLabel#actuatorName { color: #000000; }

QLabel#settingsTitle { color: #000000; font-size: 18px; font-weight: 600; }
QLabel#settingsDescription { color: #647487; font-size: 13px; }
QWidget#orientationPanel QLabel, QWidget#orientationPanel QComboBox { color: #000000; }
QWidget#orientationPanel QLabel#eyebrow { color: #758699; }
QWidget#orientationPanel QPushButton#settingsAction:enabled { color: #000000; }
QLabel#settingsPreserved { color: #187f73; font-size: 12px; }
QPushButton#settingsAction { color: #213f50; background: #edf3f5; border: 1px solid #d6e2e7; border-radius: 8px; }
QPushButton#settingsAction:hover { background: #dfecef; border-color: #a8c2ca; }
QPushButton#settingsAction:pressed { background: #d0e3e7; }
QPushButton#settingsDestructive { color: #b13b3b; background: #fff2f1; border: 1px solid #f0d5d2; border-radius: 8px; }
QPushButton#settingsDestructive:hover { color: white; background: #c43d3d; border-color: #c43d3d; }
QPushButton#settingsDestructive:pressed { background: #aa3030; border-color: #aa3030; }
QPushButton#settingsAction:disabled, QPushButton#settingsDestructive:disabled { color: #9ba7b4; background: #f5f7f9; border-color: #e2e7ed; }

QFrame#bistageParameters { background: #f8fafb; border: 1px solid #e1e8ee; border-radius: 8px; }
QFrame#bistageParameters:disabled, QFrame#bistageParameters[active="false"] { background: #f3f5f7; border-color: #e8edf1; }
QLabel#bistageLabel { color: #34485c; }
QLabel#bistageHint { color: #718095; font-size: 12px; }
QLabel#bistageLabel:disabled, QLabel#bistageHint:disabled { color: #a5afbb; }
QFrame#bistageParameters QDoubleSpinBox:disabled { color: #a5afbb; background: #edf1f4; border-color: #e0e5ea; }

QLabel#flightStateSequence { color: #000000; }

QLabel#controlWarning { color: #79552b; background: #fff5e5; border: 1px solid #efdfc5; border-radius: 6px; padding: 12px; }

QFrame#imuStatus { background: #f6f8fa; border: 1px solid #dfe5eb; border-left: 5px solid #a7b5c2; border-radius: 10px; }
QFrame#imuStatus[tone="ok"] { background: #eef8f2; border-color: #c6e4d2; border-left-color: #218653; }
QFrame#imuStatus[tone="warn"] { background: #fdf6e7; border-color: #ecd9a8; border-left-color: #c08a1e; }
QFrame#imuStatus[tone="bad"] { background: #fcf0ef; border-color: #efcdca; border-left-color: #c43d3d; }
QFrame#imuStatus QLabel { background: transparent; }
QLabel#imuState { font-size: 24px; font-weight: 700; color: #5c6d80; }
QLabel#imuState[tone="ok"] { color: #187044; }
QLabel#imuState[tone="warn"] { color: #8a5f10; }
QLabel#imuState[tone="bad"] { color: #b13434; }
QLabel#imuCause { color: #4f6073; font-size: 13px; }
QLabel#imuValue { color: #183147; font-family: 'Cascadia Code', Consolas; font-size: 13px; min-width: 88px; }
QPushButton#imuVerify[attention="true"] { color: white; background: #218653; border-color: #218653; }
QPushButton#imuVerify[attention="true"]:hover { background: #197044; border-color: #197044; }
QPushButton#imuVerify[attention="true"]:pressed { background: #125c37; border-color: #125c37; }
QProgressBar#imuProgress { min-height: 10px; max-height: 10px; border-radius: 5px; }
QProgressBar#imuProgress::chunk { border-radius: 5px; }
QProgressBar#imuProgress[phase="done"] { background: #d4ecdd; }
QProgressBar#imuProgress[phase="done"]::chunk { background: #218653; }
QProgressBar#imuProgress[phase="stopped"] { background: #f6ecd4; }
QProgressBar#imuProgress[phase="stopped"]::chunk { background: #c08a1e; }
QLabel#hint[phase="loading"] { color: #167c76; }
QLabel#hint[phase="done"] { color: #187044; font-weight: 600; }
QProgressBar#imuMeter { background: rgba(33, 48, 68, 0.10); border-radius: 2px; min-height: 5px; max-height: 5px; }
QProgressBar#imuMeter::chunk { background: #24968b; border-radius: 2px; }
QLabel#imuFace { border-radius: 15px; font-weight: 700; color: #8c99a7; background: #f1f4f7; border: 1px solid #e0e6ed; }
QLabel#imuFace[step="current"] { color: #167c76; background: #e5f3f1; border: 2px solid #24968b; }
QLabel#imuFace[step="done"] { color: white; background: #218653; border-color: #218653; }
QLabel#imuBoard { background: #f8fafb; border: 1px solid #e1e8ee; border-radius: 10px; }
QLabel#imuError { padding: 10px 12px; border-radius: 6px; font-weight: 600; color: #a33030; background: #fcf0ef; border: 1px solid #efcdca; }
QLabel#imuError[tone="warn"] { color: #79552b; background: #fff5e5; border-color: #efdfc5; }
